<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net10.0-android;net10.0-ios</TargetFrameworks>

		<OutputType>Exe</OutputType>
		<RootNamespace>ShelfScan.App</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- Enable XAML source generation for faster build times and improved performance.
		     This generates C# code from XAML at compile time instead of runtime inflation.
		     To disable, remove this line.
		     For individual files, you can override by setting Inflator metadata:
		       <MauiXaml Update="MyPage.xaml" Inflator="Default" /> (reverts to defaults: Runtime for Debug, XamlC for Release)
		       <MauiXaml Update="MyPage.xaml" Inflator="Runtime" /> (force runtime inflation) -->
		<MauiXamlInflator>SourceGen</MauiXamlInflator>

		<!-- AOT + trimming. Turns on the trim/AOT analyzers for every TFM, so anything
		     that would break after trimming shows up as a build warning (IL2xxx/IL3xxx). -->
		<IsAotCompatible>true</IsAotCompatible>
		<!-- iOS: Native AOT (implies full trimming, so no TrimMode here).
		     Not conditioned on Configuration, per the MAUI Native AOT docs. -->
		<PublishAot Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">true</PublishAot>

		<!-- Display name -->
		<ApplicationTitle>ShelfScan</ApplicationTitle>

		<!-- App Identifier -->
		<ApplicationId>dev.romain.shelfscan</ApplicationId>

		<!-- Versions -->
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
		<!-- 23 = Android 6. AndroidX tracing (pulled in by ML Kit's dependencies) requires it. -->
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">23.0</SupportedOSPlatformVersion>
	</PropertyGroup>

	<!-- Android: Native AOT is experimental in .NET 10, so Mono AOT. Release builds already
	     run it with a startup profile (profiled AOT) and trim framework assemblies only.
	     Full AOT (AndroidEnableProfiledAot=false) measured 8.3 MB bigger and no faster to
	     start, so we keep profiled AOT: docs/build-log.md, step 10. -->
	<PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
		<!-- Trim our code and every package too. Never conditioned on Configuration:
		     MAUI feature switches follow TrimMode, and Debug must behave like Release. -->
		<TrimMode>full</TrimMode>
	</PropertyGroup>

	<ItemGroup>
		<!-- App Icon -->
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#512BD4">
			<!-- The foreground is drawn for Android's adaptive-icon safe zone. iOS shows the
			     whole square, so the same artwork is scaled up there. -->
			<ForegroundScale Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">1.3</ForegroundScale>
		</MauiIcon>

		<!-- Splash Screen: the icon foreground, since Android 12+ masks splash icons to the same
		     circle as adaptive icons. BaseSize makes up for its padding on iOS and older Android. -->
		<MauiSplashScreen Include="Resources\AppIcon\appiconfg.svg" Color="#512BD4" BaseSize="192,192" />

		<!-- Images -->
		<MauiImage Include="Resources\Images\*" />

		<!-- Custom Fonts -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
	</ItemGroup>

	<!-- Android OCR: ML Kit with its model bundled in the APK (about 4 MB per ABI),
	     so it works offline from the first launch instead of waiting for Play Services. -->
	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
		<PackageReference Include="Xamarin.Google.MLKit.TextRecognition" Version="116.0.1.9" />
		<!-- ML Kit brings newer AndroidX packages than MAUI's *.Ktx companions allow (NU1608).
		     Lift the companions to match instead of silencing the warning. -->
		<PackageReference Include="Xamarin.AndroidX.Collection.Ktx" Version="1.6.0.1" />
		<PackageReference Include="Xamarin.AndroidX.Fragment.Ktx" Version="1.9.0" />
		<PackageReference Include="Xamarin.AndroidX.Lifecycle.LiveData" Version="2.11.0.1" />
		<PackageReference Include="Xamarin.AndroidX.Lifecycle.LiveData.Core.Ktx" Version="2.11.0.1" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\ShelfScan.Core\ShelfScan.Core.csproj" />
	</ItemGroup>

</Project>
