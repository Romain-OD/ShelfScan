<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:core="clr-namespace:ShelfScan.Core;assembly=ShelfScan.Core"
             x:Class="ShelfScan.App.MainPage"
             Title="ShelfScan">

    <Grid RowDefinitions="Auto,*,Auto" Padding="16,8" RowSpacing="8">
        <SearchBar x:Name="Search" Placeholder="Search your shelf" TextChanged="OnSearchChanged" />

        <CollectionView x:Name="Books" Grid.Row="1">
            <CollectionView.EmptyView>
                <Label Text="Nothing here yet. Scan a cover to add a book."
                       HorizontalTextAlignment="Center" VerticalOptions="Center" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <!-- x:DataType makes these compiled bindings: no reflection, safe under NativeAOT. -->
                <DataTemplate x:DataType="core:Book">
                    <Grid ColumnDefinitions="56,*" ColumnSpacing="12" Padding="0,6">
                        <Image Source="{Binding CoverUrl}" HeightRequest="84" Aspect="AspectFit" />
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                            <Label Text="{Binding Title}" FontAttributes="Bold" FontSize="16" />
                            <Label Text="{Binding Author}" />
                            <Label Text="{Binding Year}" FontSize="12" TextColor="{StaticResource Gray500}" />
                        </VerticalStackLayout>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Button Grid.Row="2" Text="Scan a book" Clicked="OnScanClicked" />
    </Grid>

</ContentPage>
